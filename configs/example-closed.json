{
  "schema_version": 1,
  "target": {
    "base_url": "https://iam.mohaymen.ir",
    "allowed_paths": ["/login", "/api/v1/"]
  },
  "authorization": {
    "accepted": true,
    "scope_note": "EXAMPLE — replace with your documented approval (who, what scope, when). Load generation stays blocked until accepted=true AND the runtime confirmation flag is passed."
  },
  "scenario": {
    "name": "login-baseline",
    "flow": "mohaymen-login",
    "model": "closed",
    "virtual_users": 5,
    "duration": "2m",
    "ramp_up": "10s",
    "ramp_down": "10s",
    "warm_up": "15s",
    "think_time": "2s"
  },
  "transport": {
    "request_timeout": "15s",
    "dial_timeout": "5s",
    "tls_handshake_timeout": "5s",
    "response_header_timeout": "10s",
    "idle_conn_timeout": "60s",
    "max_idle_conns": 64,
    "max_idle_conns_per_host": 16,
    "max_conns_per_host": 0,
    "max_redirects": 5,
    "max_response_body_bytes": 1048576,
    "user_agent": "iam-perf/0.1 (+load-test; approved-scope-only)",
    "accept_language": "fa-IR",
    "warm_login_page": false
  },
  "credentials": {
    "username": "SRETEST",
    "password_env": "IAMPERF_TEST_PASSWORD"
  },
  "safety": {
    "max_virtual_users": 50,
    "max_requests_per_second": 100,
    "max_duration": "10m",
    "max_total_requests": 50000,
    "stop_error_rate_pct": 30,
    "stop_5xx_count": 50,
    "stop_429_count": 10,
    "stop_p99_millis": 8000,
    "min_samples_for_stop": 20
  },
  "metrics": {
    "prometheus_enabled": false,
    "prometheus_addr": "127.0.0.1:9537"
  },
  "report": {
    "output_dir": "reports",
    "formats": ["json", "csv", "terminal"]
  },
  "log": {
    "level": "info",
    "format": "text"
  },
  "flow": {
    "initiate_login_path": "/api/v1/auth/initiate-login",
    "verify_password_path": "/api/v1/auth/verifyPassword",
    "authentication_status_path": "/api/v1/auth/authentication-status",
    "login_path": "/api/v1/auth/login",
    "session_proof_path": "/api/v1/apps/users/dashboardPermissions",
    "session_proof": true,
    "authentication_status": true
  }
}
